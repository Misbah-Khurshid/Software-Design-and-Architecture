@startuml
!theme plain
skinparam shadowing false
skinparam sequenceArrowThickness 2
skinparam roundcorner 8
title ATM Cash Withdrawal — PKR 5,000

actor Customer
participant ATM
participant BankSystem
participant Account

Customer -> ATM: Insert card
Customer -> ATM: Enter PIN
ATM -> BankSystem: Validate PIN(card information, PIN)
BankSystem --> ATM: PIN validation result

alt [PIN valid]
    ATM --> Customer: Request withdrawal amount
    Customer -> ATM: Request withdrawal(PKR 5,000)
    ATM -> BankSystem: Authorize withdrawal(PKR 5,000)
    BankSystem -> Account: Check available balance(PKR 5,000)
    Account --> BankSystem: Balance check result

    alt [sufficient funds]
        BankSystem -> Account: Debit(PKR 5,000)
        Account --> BankSystem: Debit confirmed
        BankSystem --> ATM: Withdrawal approved
        ATM -> Customer: Dispense cash(PKR 5,000)
        ATM --> Customer: Display success message
    else [insufficient funds]
        BankSystem --> ATM: Withdrawal refused: insufficient funds
        ATM --> Customer: Display insufficient-funds message
        note over ATM,Account
          No debit and no cash dispensing
        end note
    end

else [PIN invalid]
    ATM --> Customer: Display invalid-PIN message
    note over ATM,BankSystem
      Withdrawal processing does not continue
    end note
end
@enduml
